rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Green Neko's public leaderboard: anyone can read, and can only write a
    // row shaped like a valid score entry (no auth in this game, so this
    // can't stop a determined client from submitting a fake score - it can
    // only stop malformed/garbage writes, same trust boundary the old
    // client-only localStorage version had, just shared instead of
    // per-browser now).
    //
    // Scoped to green_neko_leaderboard specifically and does not declare
    // any rule for other collections in this shared Firebase project -
    // this file is not the source of truth for anything outside that path.
    function isValidScoreEntry() {
      return request.resource.data.keys().hasOnly(['name', 'score', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= 1000000
        && request.resource.data.updatedAt is number;
    }

    match /green_neko_leaderboard/{entryId} {
      allow read: if true;
      allow create, update: if isValidScoreEntry();
      allow delete: if false;
    }

    // Per-week boards: green_neko_weeks/{2026-W33}/scores/{player}. Same trust
    // model and same shape as the all-time board above - the week key is only
    // a bucket, it is not a permission boundary, so an old week is as writable
    // as the current one.
    match /green_neko_weeks/{weekKey}/scores/{entryId} {
      allow read: if true;
      allow create, update: if isValidScoreEntry();
      allow delete: if false;
    }
  }
}
